ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ]; then
    echo "Architecture ($ARCH) is not supported."
	echo "Supported arch: x86_64 - run ./config-force to continue anyway."
    exit 1
fi

echo "Generating Makefile..."

cat << 'EOF' > Makefile
bin:
	gcc sb.c -o smallbasic

install:
	gcc sb.c -o /usr/bin/smallbasic



clean:
	rm -f smallbasic
EOF
